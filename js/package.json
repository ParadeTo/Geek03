{
  "name": "js",
  "version": "1.0.0",
  "description": "TypeScript Node.js Project",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "react:dev": "ts-node src/react/agent.ts",
    "react:build": "tsc && node dist/react/agent.js",
    "fc:dev": "ts-node src/react-function-call/functioncalling.ts",
    "fc:stream": "ts-node src/react-function-call/functioncalling-stream.ts",
    "graph:dev": "ts-node src/react-langgraph/index.ts",
    "graph:manual": "ts-node src/react-langgraph-manual/index.ts",
    "codeact:dev": "ts-node src/codeact/index.ts",
    "plan:simple": "ts-node src/planmode-simple/index.ts",
    "plan:advanced": "ts-node src/planmode-advanced/index.ts",
    "reflection:dev": "ts-node src/reflection/index.ts",
    "human:dev": "ts-node --transpile-only src/human-in-loop/index.ts",
    "deep:research": "ts-node src/deep-research/index.ts",
    "memory:dev": "ts-node src/memory/index.ts",
    "mem0:dev": "ts-node src/mem0/index.ts",
    "mem0:store": "ts-node src/mem0/test/store-mem.ts",
    "mem0:search": "ts-node src/mem0/test/search-mem.ts",
    "financial:akshare": "ts-node src/financial/test/test-akshare.ts",
    "financial:workflow": "ts-node --transpile-only src/financial/test/test-workflow.ts",
    "financial:full": "ts-node --transpile-only src/financial/test/test-full-workflow.ts",
    "financial:competitor": "ts-node --transpile-only src/financial/test/test-competitor-info.ts",
    "financial:data": "ts-node --transpile-only src/financial/test/test-financial-data.ts",
    "financial:caculate": "ts-node --transpile-only src/financial/test/test-financial-caculate.ts",
    "financial:analyze": "ts-node --transpile-only src/financial/test/test-analyze-data.ts",
    "financial:analyze-web": "ts-node --transpile-only src/financial/test/test-analyze-web.ts",
    "financial:compare": "ts-node --transpile-only src/financial/test/test-compare-data.ts",
    "financial:merger": "ts-node --transpile-only src/financial/test/test-merger-reports.ts",
    "financial:business": "ts-node --transpile-only src/financial/test/test-business-info.ts",
    "financial:valuation": "ts-node --transpile-only src/financial/test/test-valuation-model.ts",
    "financial:shareholder": "ts-node --transpile-only src/financial/test/test-shareholder-info.ts",
    "financial:company": "ts-node --transpile-only src/financial/test/test-company-info.ts",
    "financial:summarize": "ts-node --transpile-only src/financial/test/test-summarize.ts",
    "financial:deep": "ts-node --transpile-only src/financial/test/test-deep-report.ts",
    "financial:html": "ts-node --transpile-only src/financial/test/test-html-generation.ts",
    "html2pdf": "ts-node --transpile-only src/financial/utils/html-to-pdf.ts",
    "server": "ts-node --transpile-only src/financial/server.ts",
    "web": "cd web && pnpm dev",
    "web:build": "cd web && pnpm build",
    "clean": "rm -rf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "typescript",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.6.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@langchain/community": "^1.0.4",
    "@langchain/core": "^1.0.1",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "@qdrant/js-client-rest": "^1.13.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/marked": "^6.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "marked": "^17.0.1",
    "openai": "^5.23.1",
    "puppeteer": "^24.34.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  }
}
